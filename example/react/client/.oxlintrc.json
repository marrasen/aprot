{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["src/api/"],
  "rules": {
    "no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "typescript/no-explicit-any": "warn",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  }
}
